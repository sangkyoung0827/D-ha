# Browser Firebase values are public configuration. The built-in D-ha project
# configuration is used when these VITE_ variables are omitted.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Server-only Heather Pet Researcher. Never prefix these with VITE_.
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL_RESEARCH=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_MODEL_GENERAL=
NVIDIA_MODEL_FALLBACK=

# Optional academic-provider identification and higher-rate credentials.
OPENALEX_API_KEY=
OPENALEX_MAILTO=
CROSSREF_MAILTO=
FIREBASE_WEB_API_KEY=
