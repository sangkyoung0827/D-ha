{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://d-ha-game.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://d-ha-game.firebaseapp.com/__/firebase/init.json"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/dog", "destination": "/dog.html" },
    { "source": "/cat", "destination": "/cat.html" },
    { "source": "/pet-health", "destination": "/pet-health.html" },
    { "source": "/dha", "destination": "/dha.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/support", "destination": "/support.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
